{
    "name": "kredibble-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "overrides": {
        "ioredis": "^5.4.1"
    },
    "scripts": {
        "dev": "node --watch --import ./src/instrument.js src/server.js",
        "start": "node --import ./src/instrument.js src/server.js",
        "db:init": "node scripts/init-db.js",
        "db:migrate": "node scripts/migrate.js",
        "db:migrate:status": "node scripts/migrate.js --status",
        "db:seed:test": "node scripts/seed-test-credentials.js",
        "user:create-admin": "node scripts/create-admin.js",
        "accounts:complete-deletions": "node scripts/complete-account-deletions.js",
        "retention:cleanup": "node -e \"import('./src/lib/data-retention.js').then(m => m.runDataRetentionSweep())\",",
        "sync:website-pull": "node scripts/website-pull.js",
        "sync:news-ingest": "node scripts/news-ingest.js",
        "sync:website-tally": "node scripts/website-tally.js",
        "sync:ambassador-pictures": "node scripts/ambassador-pictures.js",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "lint": "eslint .",
        "docs:generate": "node scripts/generate-docs.js",
        "e2e:server": "node --import ./src/instrument.js scripts/e2e-server.js",
        "e2e:server:demo": "cross-env E2E_SEED=demo node --import ./src/instrument.js scripts/e2e-server.js"
    },
    "dependencies": {
        "@sentry/node": "^11.8.0",
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.11.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^18.0.8",
        "express": "^4.19.2",
        "express-rate-limit": "^8.7.1",
        "file-type": "^22.2.0",
        "helmet": "^8.3.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^7.7.0",
        "mongoose": "^9.11.2",
        "mongoose-to-swagger": "^1.5.1",
        "morgan": "^1.12.1",
        "multer": "^2.4.0",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.2.0",
        "rate-limit-redis": "^6.0.1",
        "resend": "^6.34.1",
        "socket.io": "^4.8.4",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/preset-env": "^8.0.7",
        "@eslint/js": "^10.0.1",
        "babel-jest": "^30.5.2",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "ioredis-mock": "^8.13.1",
        "jest": "^30.5.2",
        "mongodb-memory-server": "^11.3.0",
        "openapi-to-postmanv2": "^6.4.0",
        "socket.io-client": "^4.8.4",
        "supertest": "^7.3.1"
    }
}
