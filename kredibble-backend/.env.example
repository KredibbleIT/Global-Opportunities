# ENVIRONMENT DEPLOYMENT TEMPLATE
# The IT infrastructure plan requires three isolated environments:
# 1. Development (.env.development)
# 2. Staging (.env.staging)
# 3. Production (.env.production)
#
# IT/DevOps must inject the correct corresponding secrets into GitHub Environments
# or via the VPS Docker environment configuration.

NODE_ENV=development
PORT=4000

# Which deployment this is: development | staging | production (SEC-112).
# Leave it unset locally; deployments set it. Staging and production need NODE_ENV=production.
# APP_ENV=
# Commit SHA baked into the Docker image by CI and reported by /api/v1/health. Leave unset locally.
# RELEASE_SHA=

# CORS Configuration (Must match the environment)
# Dev: http://localhost:3000,http://localhost:8081,https://dev.app.globalopportunitydesk.com
# Stg: https://staging.app.globalopportunitydesk.com
# Prd: https://app.globalopportunitydesk.com
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Database (IT to provision separate MongoDB Atlas databases/users per environment)
DATABASE_URL="mongodb+srv://user:pass@cluster0.example.mongodb.net/kredibble-dev?retryWrites=true&w=majority"

# Security Secrets (Must be unique per environment)
# Generate via: openssl rand -base64 48
JWT_SECRET=jwt_secret_placeholder
ADMIN_JWT_SECRET=admin_jwt_secret_placeholder

# Storage & Uploads (Cloudinary)
# Separate folders or separate accounts per environment recommended
STORAGE_BUCKET=kredibble-local
STORAGE_ACCESS_KEY=storage_access_key_placeholder
STORAGE_SECRET_KEY=storage_secret_key_placeholder
CLOUDINARY_CLOUD_NAME=cloudinary_cloud_name_placeholder
CLOUDINARY_API_KEY=cloudinary_api_key_placeholder
CLOUDINARY_API_SECRET=cloudinary_api_secret_placeholder

# Redis Rate Limiter Configuration
# Local: redis://localhost:6379
# VPS: redis://redis:6379 (via Docker Compose)
REDIS_URL=redis://localhost:6379

# AI Assistant
AI_PROVIDER=openai
OPENAI_API_KEY=openai_api_key_placeholder
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=anthropic_api_key_placeholder
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Team invites (BE-028): public admin origin for one-time invite links.
# Optional; when unset the API returns a relative invite path instead.
ADMIN_APP_URL=

# WordPress API Integration
INSIGHT_GHANA_WORDPRESS_URL=insight_ghana_wordpress_url_placeholder
AFRICAN_JOURNAL_WORDPRESS_URL=african_journal_wordpress_url_placeholder
WORDPRESS_SYNC_BASE_URL=wordpress_sync_base_url_placeholder
WORDPRESS_API_KEY=wordpress_api_key_placeholder

# Email Verification (Resend)
RESEND_API_KEY=resend_api_key_placeholder
RESEND_FROM_EMAIL=Kredibble <verify@example.com>
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
OUTBOUND_REQUEST_TIMEOUT_MS=10000

# Phone push notifications (Expo push service). On unless set to false.
PUSH_ENABLED=true
# Only needed when "enhanced push security" is turned on for the Expo project.
EXPO_ACCESS_TOKEN=
AI_SYSTEM_PROMPT="You are the Global Opportunities assistant. Give accurate, helpful opportunity guidance."
