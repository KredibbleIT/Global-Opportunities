# Admin Dashboard Environment Variables Template
# The IT infrastructure plan requires three isolated environments:
# 1. Development (.env.development)
# 2. Staging (.env.staging)
# 3. Production (.env.production)

# In local development (calling local API directly):
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# In production/staging environments, the API calls are proxied through Vercel
# to ensure SameSite=Strict cookies function properly across the same origin.
# NEXT_PUBLIC_API_URL=/api

# Proxy target for the respective environments:
# Dev: https://dev.api.globalopportunitydesk.com
# Stg: https://staging.api.globalopportunitydesk.com
# Prd: https://api.globalopportunitydesk.com
API_PROXY_TARGET=http://localhost:4000/api
