{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev-api.globalopportunitydesk.com/api/v1"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.globalopportunitydesk.com/api/v1"
      },
      "channel": "staging"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kredibble-api.onrender.com/api/v1"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
